    "check-placeholders": "node scripts/check-placeholders.js",
    "prebuild": "prisma generate"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@prisma/client": "^6.9.0",
    "next-auth": "^5.0.0-beta.25",
    "@auth/prisma-adapter": "^2.8.0",
    "xstate": "^5.19.0",
    "@xstate/react": "^5.0.0",
    "zod": "^3.24.0",
    "bcryptjs": "^3.0.0",
    "razorpay": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/bcryptjs": "^2.4.6",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "typescript": "^5",
    "prisma": "^6.9.0",
    "tsx": "^4.19.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
