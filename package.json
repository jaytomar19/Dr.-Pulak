  "private": true,
  "description": "Patient-acquisition funnel website for Dr. Pulak Vatsya — StepUp Joints, New Delhi",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "db:generate": "prisma generate",
