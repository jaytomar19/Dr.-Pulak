# ===========================================
# drpulakvatsya.com — Environment Variables
# ===========================================
# Copy this file to .env.local and fill in values.
# NEVER commit .env.local to version control.

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/drpulakvatsya

# NextAuth.js
NEXTAUTH_SECRET=generate-a-secret-here
NEXTAUTH_URL=http://localhost:3000

# CRM
CRM_PROVIDER=zoho
CRM_API_KEY=
CRM_API_BASE_URL=

# WhatsApp BSP (Phase 2)
WHATSAPP_BSP_PROVIDER=aisensy
WHATSAPP_API_KEY=
WHATSAPP_WEBHOOK_SECRET=

# Email (Transactional)
EMAIL_PROVIDER=postmark
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=noreply@drpulakvatsya.com

# Razorpay Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Booking Provider
BOOKING_PROVIDER=calcom
BOOKING_API_KEY=
BOOKING_API_BASE_URL=

# Google Analytics
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Storage — Imaging (Phase 2)
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# App Configuration
NODE_ENV=development
DATA_RESIDENCY_REGION=ap-south-1

# Encryption (required: 32 random bytes encoded as 64 hexadecimal characters)
ENCRYPTION_KEY=

# Admin Seed (first-run only)
ADMIN_SEED_EMAIL=doctor@drpulakvatsya.com
ADMIN_SEED_PASSWORD=change-me-immediately
ADMIN_SEED_NAME=Dr. Pulak Vatsya
